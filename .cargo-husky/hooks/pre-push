#!/bin/sh
#
# pre-push hook: 推送前跑更严格的检查，拦截明显问题。
# - fmt 检查
# - clippy 零警告
# - 快速单测（只 core，跳过 proptest，约 20s）
#
# 跳过 hook：git push --no-verify
# 完全禁用 cargo-husky 安装：CARGO_HUSKY_DONT_INSTALL_HOOKS=true cargo test

set -e

echo '[pre-push] (1/3) cargo fmt --all -- --check'
cargo fmt --all -- --check

echo '[pre-push] (2/3) cargo clippy --workspace -- -D warnings'
cargo clippy --workspace -- -D warnings

echo '[pre-push] (3/3) cargo nextest run (core, skip proptest)'
# 需要 cargo-nextest，未装时回退到 cargo test
if command -v cargo-nextest >/dev/null 2>&1; then
    PROPTEST_CASES=32 cargo nextest run -p bitcat-core -E 'not test(/prop_/)'
else
    echo '[pre-push] cargo-nextest 未安装，回退到 cargo test（较慢）'
    cargo test -p bitcat-core
fi

echo '[pre-push] 全部通过 ✓'
