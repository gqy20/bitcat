#!/bin/sh
#
# pre-push hook: run stricter checks before pushing.
# - fmt check
# - clippy with warnings denied
# - fast core tests, skipping proptest
#
# Skip once with: git push --no-verify
# Disable cargo-husky install with: CARGO_HUSKY_DONT_INSTALL_HOOKS=true cargo test

set -e

echo '[pre-push] (1/3) cargo fmt --all -- --check'
cargo fmt --all -- --check

echo '[pre-push] (2/3) cargo clippy --workspace -- -D warnings'
cargo clippy --workspace -- -D warnings

echo '[pre-push] (3/3) cargo nextest run (core, skip proptest)'
if command -v cargo-nextest >/dev/null 2>&1; then
    PROPTEST_CASES=32 cargo nextest run -p bitcat-core -E 'not test(/prop_/)'
else
    echo '[pre-push] cargo-nextest is not installed; falling back to cargo test'
    cargo test -p bitcat-core
fi

echo '[pre-push] all checks passed'