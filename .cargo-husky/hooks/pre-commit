#!/bin/sh
#
# pre-commit hook: 仅做秒级检查，保证提交总能过。
# - cargo fmt --all -- --check: 全 workspace 格式检查
#
# 跳过 hook：git commit --no-verify
# 完全禁用 cargo-husky 安装：CARGO_HUSKY_DONT_INSTALL_HOOKS=true cargo test

set -e

# 只对暂存区里有 .rs 变更时才跑 fmt，避免纯文档/配置 commit 也跑 cargo
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$'; then
    echo '[pre-commit] cargo fmt --all -- --check'
    cargo fmt --all -- --check
else
    echo '[pre-commit] 无 .rs 变更，跳过 fmt 检查'
fi
