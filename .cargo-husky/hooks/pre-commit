#!/bin/sh
#
# pre-commit hook: 仅做秒级检查，保证提交总能过。
# - cargo fmt --all -- --check: 按 workspace 配置检查 Rust 格式
#
# 跳过 hook：git commit --no-verify
# 完全禁用 cargo-husky 安装：CARGO_HUSKY_DONT_INSTALL_HOOKS=true cargo test

set -e

# 收集暂存区中的 .rs 文件
staged_rs=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)

if [ -z "$staged_rs" ]; then
    echo '[pre-commit] 无 .rs 变更，跳过 fmt 检查'
    exit 0
fi

echo '[pre-commit] 检查暂存区 .rs 文件格式'

if ! cargo fmt --all -- --check; then
    echo "[pre-commit] 运行 cargo fmt 修复后再提交"
    exit 1
fi

echo '[pre-commit] fmt 检查通过'
