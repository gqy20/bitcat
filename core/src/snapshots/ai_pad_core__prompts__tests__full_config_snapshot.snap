---
source: core/src/prompts.rs
expression: cfg
---
agent:
  preamble: 自定义 agent 提示词
vision:
  prompt: 自定义视觉提示词
  prompt_multi: 多屏提示
memory:
  max_entries: 20
  max_context_chars: 1500
  max_user_chars: 100
  max_reply_chars: 200
memory_v2:
  long_term_max_entries: 200
  retrieve_budget_chars: 800
  aggregation_interval_min: 24
screen_summary:
  interval_min: 15
  max_recent_analyses: 30
  prompt: "你是 8Bit 的观察模块。以下是一段时间内对主人屏幕的多次 AI 观察记录。\n\n请将它们整理为结构化的活动日志：\n- 按活动类型分组（编程、浏览、通讯、娱乐、文档等）\n- 每组列出时间段和具体活动\n- 合并重复的观察（如连续多次看到同一应用，合并为时间段范围）\n- 保留关键细节（项目名、文件名、网站等能看清的信息）\n- 控制在 300 字以内\n"
  max_context_entries: 20
  max_context_chars: 2000
aggregation:
  prompt: ""
